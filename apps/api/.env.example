# Copy to apps/api/.env. Never commit the copied file.
# Local API defaults: http://127.0.0.1:3000; Vite uses http://127.0.0.1:5173.
NODE_ENV=development
PORT=3000

# Neon PostgreSQL URL for a development/test database. Do not use production for fixtures.
DATABASE_URL=

# Clerk dashboard: publishable key and secret key for the same development instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional Clerk JWT verification key; set only if the Clerk deployment uses it.
CLERK_JWT_KEY=
# Exact origins, comma-separated. Keep the local Vite origin for development.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173

# Evidence feedback provider. Leave AI_ENABLED=false until a provider/model is configured.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# AI Debugging Lab stays off unless both keys and a supported model are configured.
SANDBOX_ENABLED=false
E2B_API_KEY=
SANDBOX_AGENT_MODEL=
SANDBOX_MAX_ACTIVE=4
SANDBOX_SESSION_TTL_SECONDS=1200

# Set by a release build when production readiness validation is enabled.
APP_COMMIT_SHA=
